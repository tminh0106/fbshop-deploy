<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <defs>
    <radialGradient id="grad" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#ffffff"/>
      <stop offset="100%" stop-color="#f1f5f9"/>
    </radialGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-opacity="0.15"/>
    </filter>
  </defs>
  <rect width="400" height="400" rx="24" fill="url(#grad)"/>
  
  <!-- Racket Frame -->
  <g filter="url(#shadow)" transform="translate(200, 190)">
    <!-- Racket Head -->
    <ellipse cx="0" cy="-60" rx="65" ry="85" fill="none" stroke="#ef4444" stroke-width="7"/>
    <ellipse cx="0" cy="-60" rx="61" ry="81" fill="none" stroke="#334155" stroke-width="2"/>
    
    <!-- Strings pattern -->
    <line x1="-35" y1="-120" x2="-35" y2="0" stroke="#cbd5e1" stroke-width="1.2"/>
    <line x1="-20" y1="-135" x2="-20" y2="15" stroke="#cbd5e1" stroke-width="1.2"/>
    <line x1="0" y1="-140" x2="0" y2="20" stroke="#cbd5e1" stroke-width="1.2"/>
    <line x1="20" y1="-135" x2="20" y2="15" stroke="#cbd5e1" stroke-width="1.2"/>
    <line x1="35" y1="-120" x2="35" y2="0" stroke="#cbd5e1" stroke-width="1.2"/>
    
    <line x1="-50" y1="-100" x2="50" y2="-100" stroke="#cbd5e1" stroke-width="1.2"/>
    <line x1="-60" y1="-80" x2="60" y2="-80" stroke="#cbd5e1" stroke-width="1.2"/>
    <line x1="-63" y1="-60" x2="63" y2="-60" stroke="#cbd5e1" stroke-width="1.2"/>
    <line x1="-60" y1="-40" x2="60" y2="-40" stroke="#cbd5e1" stroke-width="1.2"/>
    <line x1="-50" y1="-20" x2="50" y2="-20" stroke="#cbd5e1" stroke-width="1.2"/>
    
    <!-- T-Joint -->
    <path d="M -8 24 L 8 24 L 5 45 L -5 45 Z" fill="#ef4444"/>
    
    <!-- Shaft -->
    <rect x="-4" y="45" width="8" height="85" fill="#334155"/>
    <rect x="-2" y="55" width="4" height="65" fill="#ef4444"/>
    
    <!-- Grip / Handle -->
    <rect x="-8" y="130" width="16" height="55" rx="3" fill="#1e293b"/>
    <line x1="-8" y1="145" x2="8" y2="140" stroke="#475569" stroke-width="1.5"/>
    <line x1="-8" y1="160" x2="8" y2="155" stroke="#475569" stroke-width="1.5"/>
    <line x1="-8" y1="175" x2="8" y2="170" stroke="#475569" stroke-width="1.5"/>
    <!-- End Cap -->
    <rect x="-9" y="182" width="18" height="6" rx="2" fill="#ef4444"/>
  </g>
  
  <!-- Brand & Model Tag -->
  <rect x="30" y="25" width="90" height="24" rx="12" fill="#ef4444" opacity="0.15"/>
  <text x="75" y="41" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif" font-size="11" font-weight="900" fill="#ef4444">
    YONEX
  </text>
  <text x="200" y="370" text-anchor="middle" font-family="-apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif" font-size="12" font-weight="700" fill="#64748b" letter-spacing="1">
    ARCSABER 11 PRO
  </text>
</svg>